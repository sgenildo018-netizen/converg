    "texto": "<header\n                class=\"fixed top-0 left-64 right-0 h-14 bg-surface-container-lowest/80 backdrop-blur-xl border-b border-outline-variant/20 z-40 px-space-md flex items-center justify-between gap-space-md\"\n            >\n                <div class=\"flex items-center gap-space-sm flex-1 max-w-xl\">\n                    <button\n                        class=\"w-full flex items-center justify-between px-space-sm py-1.5 bg-surface-container-low hover:bg-surface-container rounded-lg border border-outline-variant/30 text-on-surface-variant hover:text-on-surface transition-all\"\n                        type=\"button\"\n                    >\n                        <div class=\"flex items-center gap-2\">\n                            <span\n                                class=\"material-symbols-outlined text-[16px] text-outline\"\n                                >search</span\n                            ><span class=\"font-body-sm text-body-sm\"\n                                >Buscar notas, tags ou snippets...</span\n                            >\n                        </div>\n                        <kbd\n                            class=\"px-1.5 py-0.5 text-label-kbd font-label-kbd bg-surface-container-high border border-outline-variant/40 rounded text-outline shadow-sm\"\n                            >⌘K</kbd\n                        >\n                    </button>\n                </div>\n                <div class=\"flex items-center gap-space-sm\">\n                    <button\n                        class=\"flex items-center gap-1 px-space-xs py-1 rounded text-body-sm font-body-sm text-on-surface-variant hover:bg-surface-container hover:text-on-surface transition-colors\"\n                        type=\"button\"\n                    >\n                        <span class=\"material-symbols-outlined text-[16px]\"\n                            >download</span\n                        ><span class=\"hidden xl:inline\"\n                            >Exportar Markdown</span\n                        ></button\n                    ><button\n                        class=\"flex items-center gap-1 px-space-xs py-1 rounded text-body-sm font-body-sm text-on-surface-variant hover:bg-surface-container hover:text-on-surface transition-colors\"\n                        type=\"button\"\n                    >\n                        <span class=\"material-symbols-outlined text-[16px]\"\n                            >center_focus_strong</span\n                        ><span class=\"hidden xl:inline\">Modo Foco</span></button\n                    ><button\n                        class=\"p-1 text-on-surface-variant hover:text-on-surface hover:bg-surface-container rounded transition-colors relative\"\n                        title=\"Notificações\"\n                        type=\"button\"\n                    >\n                        <span class=\"material-symbols-outlined text-[18px]\"\n                            >notifications</span\n                        ><span\n                            class=\"absolute top-1 right-1 w-1.5 h-1.5 rounded-full bg-primary\"\n                        ></span></button\n                    ><button\n                        class=\"flex items-center gap-1.5 bg-primary-container text-on-primary-container px-space-sm py-1 rounded-lg font-medium text-body-sm shadow-[inset_0_1px_0_rgba(255,255,255,0.2)] hover:opacity-95 transition-all\"\n                        type=\"button\"\n                    >\n                        <span class=\"material-symbols-outlined text-[16px]\"\n                            >add</span\n                        ><span>Novo Artigo</span>\n                    </button>\n                    <div\n                        class=\"w-8 h-8 rounded-full bg-primary flex items-center justify-center\"\n                    >\n                        <span\n                            class=\"material-symbols-outlined text-on-primary text-[18px]\"\n                            >person</span\n                        >\n                    </div>\n                </div>\n            </header>"
  },
